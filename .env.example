# Copy to .env for local development; .env is git-ignored.
# Every variable is described in docs/plan/architecture.md §11.

# Dev and test databases from docker/compose.dev.yml (`pnpm db:up`).
DATABASE_URL=postgres://ge:ge@127.0.0.1:5442/ge
TEST_DATABASE_URL=postgres://ge:ge@127.0.0.1:5443/ge_test

# Uploaded images; relative paths are read from the repository root.
# GE_MEDIA_DIR=./.data/media

# Accounts (M8-T1). Off on your own machine: GE_AUTH_MODE=none has no login and lets
# everything edit. To try logins locally, set all three, then make an account with
# `pnpm admin:create-user --admin` and sign in at http://localhost:5173/login.
# GE_AUTH_MODE=required
# GE_SESSION_SECRET=   # 32+ random characters, such as from `openssl rand -base64 48`
# GE_PUBLIC_URL=http://localhost:5173
# Behind a proxy, whose X-Forwarded-For to believe (for the rate limits), such as `loopback`.
# GE_TRUST_PROXY=
# The rate limits on every route (M8-T3): `off` only for test runs whose browsers all come from
# one address (the e2e tests and `pnpm perf` turn them off themselves).
# GE_RATE_LIMITS=on

# Remote MCP (M8-T2, `pnpm mcp:http`): where it listens. Anywhere but a loopback address,
# every request needs an API token. `pnpm mcp` and `pnpm mcp:http` read GE_API_URL (default
# http://127.0.0.1:3100); `pnpm mcp` sends GE_API_TOKEN, when set, with every call.
# GE_MCP_HOST=127.0.0.1
# GE_MCP_PORT=3110
# GE_API_TOKEN=
