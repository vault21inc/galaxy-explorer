# Settings for docker/compose.prod.yml (M8-T4). Copy to .env.production (git ignores .env.*),
# fill in the values, keep the file to its owner (chmod 600), and pass it with --env-file.

# The site's name, as Caddy serves it, and the same as an address. 127.0.0.1 tries the stack on
# your own machine with a certificate from Caddy's own authority (the browser warns).
GE_SITE_ADDRESS=galaxy.example.com
GE_PUBLIC_URL=https://galaxy.example.com

# Secrets: long random strings, such as from `openssl rand -base64 48`. Changing
# GE_SESSION_SECRET locks every account out of its two-factor codes.
GE_DB_PASSWORD=
GE_SESSION_SECRET=

# Optional.
# GE_LOG_LEVEL=info
# GE_WIKI_USER_AGENT=GalaxyExplorer/1.0 (contact: you@example.com)
# GE_HTTP_PORT=80
# GE_HTTPS_PORT=443
# The images to run: built here by default, or the deploy pipeline's (M8-T6).
# GE_IMAGE_PREFIX=ghcr.io/vault21inc/galaxy-explorer
# GE_IMAGE_TAG=local
# The web app's build settings, such as the first-visit defaults (D-38).
# VITE_DEFAULT_LABEL_MODE=
# VITE_DEFAULT_SPOILERS=
