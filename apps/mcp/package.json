{
  "name": "@ge/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for LLM agents: tools generated from the registries, calling the REST API.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:http": "node src/http-main.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@ge/api-client": "workspace:*",
    "@ge/domain": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@ge/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
