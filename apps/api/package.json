{
  "name": "@ge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify REST API under /api/v1, with OpenAPI docs at /api/docs.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@ge/db": "workspace:*",
    "@ge/domain": "workspace:*",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@ge/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "openapi-types": "12.1.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
