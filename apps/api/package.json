{
  "name": "@ge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify REST API under /api/v1, with OpenAPI docs at /api/docs.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "openapi:write": "node src/openapi-cli.ts ../../packages/api-client/openapi.json",
    "seed": "node --env-file-if-exists=../../.env src/seeds/cli.ts"
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@ge/db": "workspace:*",
    "@ge/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.3.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@ge/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/sanitize-html": "2.16.2",
    "eslint": "catalog:",
    "openapi-types": "12.1.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
