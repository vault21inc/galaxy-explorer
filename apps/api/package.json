{
  "name": "@ge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify REST API under /api/v1, with OpenAPI docs at /api/docs.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "openapi:write": "node src/openapi-cli.ts ../../packages/api-client/openapi.json",
    "headers:caddy": "node src/http/caddy-headers-cli.ts",
    "seed": "node --env-file-if-exists=../../.env src/seeds/cli.ts",
    "admin": "node --env-file-if-exists=../../.env src/auth/cli.ts"
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/sensible": "6.0.8",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "@ge/db": "workspace:*",
    "@ge/domain": "workspace:*",
    "@iconify-json/game-icons": "1.2.4",
    "@iconify-json/lucide": "1.2.156",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "catalog:",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "fflate": "0.8.3",
    "file-type": "22.3.0",
    "otplib": "13.6.0",
    "qrcode": "1.5.4",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@ge/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.2",
    "eslint": "catalog:",
    "openapi-types": "12.1.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
