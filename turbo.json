{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "GE_*"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "cache": false
    }
  }
}
