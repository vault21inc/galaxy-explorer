{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ge/api", "dev"],
      "port": 3100,
      "url": "http://127.0.0.1:3100"
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ge/web", "dev"],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "mcp-http",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["mcp:http"],
      "port": 3110,
      "url": "http://127.0.0.1:3110"
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ge/web", "preview", "--port", "4173", "--strictPort"],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
