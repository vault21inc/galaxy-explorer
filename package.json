{
  "name": "galaxy-explorer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:stack": "pnpm --filter @ge/web exec playwright test -c playwright.stack.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f docker/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "db:psql": "docker compose -f docker/compose.dev.yml exec db psql -U ge -d ge",
    "db:generate": "pnpm --filter @ge/db db:generate",
    "db:migrate": "pnpm --filter @ge/db db:migrate",
    "db:reset": "pnpm --filter @ge/db db:reset && pnpm --filter @ge/api seed demo",
    "db:seed": "pnpm --filter @ge/api seed",
    "api:generate": "pnpm --filter @ge/api openapi:write && pnpm --filter @ge/api-client generate",
    "api:check": "pnpm api:generate && git diff --exit-code -- packages/api-client/openapi.json packages/api-client/src/generated",
    "headers:caddy": "pnpm --silent --filter @ge/api headers:caddy",
    "check": "prettier --check . && turbo run lint typecheck test",
    "perf": "pnpm --filter @ge/perf perf",
    "mcp": "pnpm --silent --filter @ge/mcp start",
    "mcp:http": "pnpm --silent --filter @ge/mcp start:http",
    "admin:create-user": "pnpm --silent --filter @ge/api admin create-user",
    "admin:invite": "pnpm --silent --filter @ge/api admin invite",
    "admin:reset-link": "pnpm --silent --filter @ge/api admin reset-link"
  },
  "devDependencies": {
    "@ge/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
