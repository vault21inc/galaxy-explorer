{
  "name": "@ge/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript, ESLint and Prettier settings, and the layering rules between workspace packages.",
  "exports": {
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.js",
    "./vitest": "./vitest.js",
    "./workspace": "./workspace.js",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./test-api": {
      "types": "./test-api.d.ts",
      "default": "./test-api.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
