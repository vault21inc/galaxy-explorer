# The private preview's settings (docs/ops/preview.md). Copy to /srv/galaxy-explorer/preview.env
# on the server, fill in the password, and keep it there only: chmod 600, never committed.

# The database (ops/preview/compose.yml reads GE_DB_PASSWORD too).
GE_DB_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgres://ge:change-me-to-a-long-random-string@127.0.0.1:5432/ge

# The API: on this server only, behind Caddy, which decides who may edit.
GE_AUTH_MODE=none
GE_HOST=127.0.0.1
GE_PORT=3100
GE_PREVIEW_ROLES=on
GE_MEDIA_DIR=/srv/galaxy-explorer/media
GE_LOG_LEVEL=info
